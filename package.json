{
  "name": "vibe-curator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:native": "tauri dev",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-4173} --strictPort",
    "build": "npm run check:licenses && tsc --noEmit && vite build",
    "build:native": "tauri build",
    "build:chrome": "npm --prefix chrome-extension run build",
    "test:chrome": "npm --prefix chrome-extension test",
    "verify:chrome": "npm --prefix chrome-extension run verify",
    "package:chrome": "npm --prefix chrome-extension run package",
    "preview": "vite preview",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:native": "node scripts/check-native-release.mjs",
    "test:native": "node --test --experimental-strip-types test/native-release.test.ts",
    "gen:fixtures": "node scripts/make-dev-fixtures.mjs",
    "gen:effects": "node scripts/generate-builtin-effects.mjs",
    "report:effect-costs": "node scripts/report-effect-costs.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@google/genai": "^2.16.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "better-auth": "^1.6.30",
    "pg": "^8.23.0",
    "pixi.js": "^8.6.6",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/pg": "^8.23.1",
    "auth": "1.6.30",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "overrides": {
    "lodash": "4.18.1",
    "nanoid": "3.3.18"
  }
}
