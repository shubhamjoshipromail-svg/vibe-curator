{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibe Curator",
  "version": "0.1.1",
  "identifier": "com.vibecurator.player",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0",
    "devUrl": "http://localhost:5178/wallpaper.html?preset=market-pixel-last-broadcast",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "wallpaper",
        "title": "Vibe Curator",
        "url": "wallpaper.html?preset=market-pixel-last-broadcast",
        "width": 1440,
        "height": 900,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnBottom": false,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true
      },
      {
        "label": "native-controls",
        "title": "Vibe Curator Controls",
        "url": "native-controls.html",
        "width": 340,
        "height": 430,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:5178 ws://localhost:5178 https:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "media-src": "'self' asset: http://asset.localhost blob: data: https:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["vibecurator"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "Living audiovisual wallpapers from Vibe Curator"
  }
}
