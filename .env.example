# Copy to .env and fill in. .env is gitignored and never reaches the browser.
#
# IMPORTANT: do NOT rename these with a VITE_ prefix. Vite inlines any
# VITE_-prefixed variable into the client bundle, which would publish your key
# to every visitor. These are read server-side only, by server/gen-shader.ts.

# GEN-EFFECT shader generation.
ANTHROPIC_API_KEY=

# Reserved for the music pipeline (not yet wired).
# GEMINI_API_KEY=
# ELEVENLABS_API_KEY=
