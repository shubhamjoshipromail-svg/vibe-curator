# Copy to .env and fill in. .env is gitignored and never reaches the browser.
#
# IMPORTANT: do NOT rename API credentials with a VITE_ prefix. Vite inlines any
# VITE_-prefixed variable into the client bundle, which would publish a secret
# to every visitor. The public Chrome extension ID near the bottom is the one
# intentional exception.

# GEN-EFFECT shader generation and artist-reference-safe music prompt adaptation.
ANTHROPIC_API_KEY=

# Source image generation through OpenAI GPT Image.
OPENAI_API_KEY=

# Optional still-image motion generation through Gemini Veo.
GEMINI_API_KEY=

# One-time music asset generation through ElevenLabs Music v2.
ELEVENLABS_API_KEY=

# Optional estimated media spend ceiling for one dev-server session.
MEDIA_GENERATION_CAP_USD=3

# Safe beta controls. Production defaults AI generation to off and billing to
# off even when old provider/Stripe credentials are present. Enable deliberately.
# off = curated/upload/edit only; light = shader + scene direction; full = all.
BETA_GENERATION_MODE=off
# Per-operation overrides take precedence over the mode. The invited beta can
# enable inexpensive calls while keeping unreliable/expensive Veo motion off.
ENABLE_IMAGE_GENERATION=false
ENABLE_MUSIC_GENERATION=false
ENABLE_MOTION_GENERATION=false
ENABLE_SHADER_GENERATION=false
ENABLE_DIRECTION_GENERATION=false
BETA_DAILY_SPEND_CAP_USD=5
BETA_USER_DAILY_SPEND_CAP_USD=1
ENABLE_BILLING=false

# Authentication and per-user persistence. Railway Postgres supplies DATABASE_URL.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5178
# Canonical public origin. In production set this to the HTTPS Railway/custom
# domain; BETTER_AUTH_URL may be omitted when APP_URL is present.
APP_URL=http://localhost:5178
# Compile native release bundles with the deployed HTTPS editor origin:
# VIBE_APP_URL=https://vibe-curator-production.up.railway.app

# Optional until the Google Cloud OAuth client is created. The guest account
# flow works without these and is automatically claimed after Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe test-mode billing. Price ids are created in the Stripe Dashboard;
# clients select a fixed product key and can never submit arbitrary price ids.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREDITS_100=
## Optional public Chrome extension ID override for unpacked/staging builds (not a secret).
VITE_CHROME_EXTENSION_ID=
