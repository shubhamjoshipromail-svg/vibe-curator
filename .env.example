# Copy to .env and fill in. .env is gitignored and never reaches the browser.
#
# IMPORTANT: do NOT rename these with a VITE_ prefix. Vite inlines any
# VITE_-prefixed variable into the client bundle, which would publish your key
# to every visitor. These are read server-side only, by server/gen-shader.ts.

# GEN-EFFECT shader generation and artist-reference-safe music prompt adaptation.
ANTHROPIC_API_KEY=

# Source image generation through OpenAI GPT Image.
OPENAI_API_KEY=

# Optional still-image motion generation through Gemini Veo.
GEMINI_API_KEY=

# One-time music asset generation through ElevenLabs Music v2.
ELEVENLABS_API_KEY=

# Optional estimated media spend ceiling for one dev-server session.
MEDIA_GENERATION_CAP_USD=3

# Authentication and per-user persistence. Railway Postgres supplies DATABASE_URL.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5178

# Optional until the Google Cloud OAuth client is created. The guest account
# flow works without these and is automatically claimed after Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
